# Normalize line endings to LF in the repository (cross-platform friendly).
* text=auto eol=lf

# Binary-ish files that should always stay as-is
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated model artifacts are JSON text; keep LF.
*.model.json text eol=lf
