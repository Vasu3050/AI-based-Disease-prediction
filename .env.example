# ==================================================================
# MediPredict AI — environment configuration (TEMPLATE)
# ------------------------------------------------------------------
# WHERE TO PUT THIS FILE (both locations are supported; values in
# <repo-root>/.env win when the same key exists in both):
#   A) <repo-root>/.env          (recommended)
#   B) <repo-root>/server/.env
#
# Fill in real values. NEVER commit `.env` to Git.
# The server validates everything at startup and fails fast with a
# clear error message when required values are missing.
# ==================================================================

# ---- Runtime -----------------------------------------------------
# development | production | test
NODE_ENV=development

# Port the API server listens on
PORT=5000

# ---- Database ----------------------------------------------------
# MongoDB connection string. Works with a local MongoDB service or an
# Atlas cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/medipredict

# ---- Authentication ------------------------------------------------
# Secret used to sign JWTs. MUST be a long random string (>= 32 chars).
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change…ters

# JWT / session lifetime (e.g. 12h, 7d)
JWT_EXPIRES_IN=7d

# Name of the HTTP-only auth cookie
COOKIE_NAME=mp_token

# ---- CORS / Client ------------------------------------------------
# Origin of the frontend dev server (used for CORS allow-list + cookies)
CLIENT_URL=http://localhost:5173

# ==================================================================
# LLM provider (OPTIONAL) — switch models by editing THIS FILE ONLY
# # -----------------------------------------------------------------
# The core application (analysis + ML prediction) works WITHOUT any
# LLM. The LLM layer only writes natural-language explanations of
# already-computed structured results.
#
# To switch models: change the values below and restart the server.
# No code changes are ever needed:
#   * switch local <-> online      -> change LLM_PROVIDER / LLM_BASE_URL
#   * switch model on same server  -> change LLM_MODEL
#   * disable the LLM layer        -> LLM_PROVIDER=none
#
# Provider values: none | ollama | openai-compatible | xai
#
# --- Preset A: LOCAL Ollama (no API key needed) --------------------
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=deepseek-r1:14b          # any model from `ollama list`
#
# --- Preset B: xAI Grok (online) -----------------------------------
#   LLM_PROVIDER=xai
#   LLM_BASE_URL=https://api.x.ai/v1
#   LLM_API_KEY=xai-...
#   LLM_MODEL=grok-2-latest
#
# --- Preset C: any OpenAI-compatible cloud -------------------------
#   LLM_PROVIDER=openai-compatible
#   LLM_BASE_URL=https://api.groq.com/openai/v1     # or OpenAI/OpenRouter/...
#   LLM_API_KEY=...
#   LLM_MODEL=llama-3.3-70b-versatile
#
# Tip: local "reasoning" models can take a while (first call loads the model
# and thinking tokens are generated before the answer). Raise
# LLM_TIMEOUT_MS (e.g. 600000 for a 14B reasoning model) if you see
# timeout fallbacks.
# ==================================================================
LLM_PROVIDER=none

# API key — SERVER-SIDE ONLY. Never put this in frontend code.
LLM_API_KEY=

# Base URL of the OpenAI-compatible endpoint
LLM_BASE_URL=

# Model name, e.g. deepseek-r1:14b / grok-2-latest / llama-3.3-70b-versatile
LLM_MODEL=

# Request timeout in milliseconds (local reasoning models: 600000+)
LLM_TIMEOUT_MS=20000

# ---- ML models ----------------------------------------------------
# Directory containing trained model artifacts (JSON).
# Defaults to <repo-root>/ml/models when left empty.
MODELS_DIR=

# ---- Demo seeding --------------------------------------------------
# Credentials used by `npm run demo:seed` for the built-in demo account.
DEMO_USER_EMAIL=demo@medipredict.local
DEMO_USER_PASSWORD=DemoPass123!

# ---- Client (Vite) -------------------------------------------------
# In development the client proxies /api to the server, so this is only
# needed for non-proxy setups. Do NOT place secrets in VITE_* variables.
# VITE_API_URL=http://localhost:5000/api
